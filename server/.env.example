# Copy to server/.env for local development (server/.env is gitignored; never commit it).

# Port to listen on. Render sets this automatically.
PORT=3001
# Comma-separated list of client origins allowed to connect.
CLIENT_ORIGIN=http://localhost:5173

# Supabase: Project Settings -> API. Leave unset to keep boards in memory only.
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (sb_secret_...), not the publishable one. Server only: it bypasses row-level security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
